{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "types": [
      "node"
    ],
    "target": "ES2023",
    "outDir": "./dist",
    "rootDir": "./app",
    "declaration": false,
    "removeComments": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "strictPropertyInitialization": false,
    "noImplicitAny": false,
    "forceConsistentCasingInFileNames": true,
    "lib": [
      "ES2021"
    ]
  },
  "include": [
    "app/modules/**/*",
    "node_modules/@eastonshay/sara/app/types/express.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
