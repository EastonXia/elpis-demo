{
  "name": "elpis-demo",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "npm run build:modules && concurrently -n tsc,server \"npm run build:modules:watch\" \"_ENV='local' nodemon --watch dist/modules --delay 1 ./server.js\"",
    "prod": "npm run build:modules && _ENV='production' node ./server.js",
    "build:dev": "_ENV='local' node --max_old_space_size=4096 ./build.js",
    "build:prod": "_ENV='prod' node ./build.js",
    "build:modules": "tsc -p tsconfig.json",
    "build:modules:watch": "tsc -w -p tsconfig.json"
  },
  "author": "EastonShay",
  "license": "ISC",
  "devDependencies": {
    "@types/express": "^4",
    "@types/node": "^22.20.5",
    "concurrently": "^9",
    "nodemon": "^3.1.9",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@eastonshay/sara": "^1.0.0",
    "class-validator": "^0.15.1",
    "element-plus": "^2.9.5",
    "generate-password": "^1.7.1",
    "jsonwebtoken": "^9.0.2",
    "less": "^4.9.1",
    "moment": "^2.30.1",
    "mysql2": "^3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^11.1.0"
  }
}
